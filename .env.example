# Copy to .env (scripts/setup.sh does this and fills in the secrets).

# Release compose only (docker-compose.release.yml): the image tag to run, e.g. 0.1.0. Default latest.
# HIVE_VERSION=latest

# Postgres password. NEVER change it after the volume exists: Postgres keeps the one it was created with.
POSTGRES_PASSWORD=

# Encrypts secrets the hive stores (the fact agent's credential). 64 hex chars: `openssl rand -hex 32`.
# scripts/setup.sh generates one. Losing it only means a curator has to set the credential again.
# Running the service outside this compose file, HIVE_SECRET_KEY_FILE=<path> (a file holding the key) works instead.
HIVE_SECRET_KEY=

# The hive-worker container's token (role worker). scripts/setup.sh mints one. Empty = the worker idles.
HIVE_WORKER_TOKEN=
# Fact agent: claude (default; the curator's subscription token, set with PUT /v1/settings/agent-credential),
# or ollama (local model, free). hermes is host-only: `pnpm --filter worker dev` on a machine with Hermes.
# HIVE_DISTILL_RUNNER=claude
# HIVE_DISTILL_MODEL=claude-sonnet-5-5   # ollama default: llama3.1
# CLAUDE_CODE_VERSION=2.1.284            # the claude CLI baked into the worker image

# Where the hive listens on the host. 127.0.0.1 = this machine only.
# Set to 0.0.0.0 or the Tailscale IP so other machines' Hermes can connect.
HIVE_BIND=127.0.0.1
HIVE_PORT=8800

# Meaning search. Ollama runs natively on the host: `brew install ollama && ollama serve`,
# then `ollama pull nomic-embed-text`. Leave OLLAMA_URL unset for the default; set it to empty for keyword-only.
# OLLAMA_URL=http://host.docker.internal:11434
# HIVE_VECTOR_MIN_SIM=0.55   # cosine floor; below it a "meaning" hit is treated as unrelated

# Repos the hive can ingest and verify must live under this host directory (mounted read-only).
# HIVE_REPOS_HOST_ROOT=/Users/you/dev
# HIVE_REPO_SYNC_MINUTES=15   # ingest + verify every registered repo this often; 0 = only on demand

# Webhooks on fact changes (POST /v1/webhooks): a failed delivery is retried after 30 s, 60 s, 120 s, ... (capped
# at 1 h) and given up on after this many attempts.
# HIVE_WEBHOOK_MAX_ATTEMPTS=6
# HIVE_WEBHOOK_BACKOFF_SECONDS=30

# A fact nobody has used (brief, recall, citation) or kept for this many days is listed as stale for a curator.
# HIVE_STALE_DAYS=60

# Host port for Postgres (tests, psql). Loopback only. 5432 is often taken by other stacks.
HIVE_PG_PORT=5544
