# Copy to .env (scripts/setup.sh does this and fills in the secrets).

# Postgres password. NEVER change it after the volume exists: Postgres keeps the one it was created with.
POSTGRES_PASSWORD=

# Where the hive listens on the host. 127.0.0.1 = this machine only.
# Set to 0.0.0.0 or the Tailscale IP so other machines' Hermes can connect.
HIVE_BIND=127.0.0.1
HIVE_PORT=8800

# Host port for Postgres (tests, psql). Loopback only. 5432 is often taken by other stacks.
HIVE_PG_PORT=5544
